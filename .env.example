PORT=8080
NODE_ENV=development
MONGO_INITDB_ROOT_USERNAME=user
MONGO_INITDB_ROOT_PASSWORD=pass
MONGO_URI=mongodb://user:pass@mongodb:27017/ucrs?authSource=admin&replicaSet=ucrs
# Generate a real secret:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Set an initial password for the administrator before running npm run seed.
ADMIN_EMAIL=admin@ucrs.test
ADMIN_PASSWORD=

SESSION_SECRET=replace-with-a-long-random-string
APP_ORIGIN=http://localhost:8080
CURRENT_TERM=2026-1

# Optional MongoDB Compass Web service (docker compose up -d compass).
# It reuses the database credentials above. Change the password before
# exposing the UI beyond localhost.
COMPASS_PORT=8001
COMPASS_AUTH_USERNAME=admin
COMPASS_AUTH_PASSWORD=secret
