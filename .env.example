PORT=8080
NODE_ENV=development

MONGO_INITDB_ROOT_USERNAME=user
MONGO_INITDB_ROOT_PASSWORD=pass

# user and pass must match MONGO_INITDB_ROOT_USERNAME and MONGO_INITDB_ROOT_PASSWORD
# mongodb:27017 for dockerized mongodb, localhost:27017 or 127.0.0.1:27017 when outside
MONGO_URI=mongodb://user:pass@mongodb:27017/ucrs?authSource=admin

# Generate a real secret:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Seeder admin account for the UCRS System
# Set an initial password for the administrator before running npm run seed.
ADMIN_EMAIL=admin@ucrs.test
ADMIN_PASSWORD=admin12345

# Generate a real secret:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
APP_ORIGIN=http://localhost:8080
CURRENT_TERM=2026-1

# MongoDB Compass Web service (docker compose up -d compass).
# It reuses the database credentials above. 
COMPASS_PORT=8001
COMPASS_AUTH_USERNAME=admin
COMPASS_AUTH_PASSWORD=secret
