<%- include('head') %>
<% const menus = {
  guest: [['/catalog/courses', 'Course catalog', 'book']],
  student: [['/student', 'Overview', 'grid'], ['/catalog/courses', 'Course catalog', 'book'],
    ['/student/enrollments', 'My enrollments', 'check'], ['/student/schedule', 'Weekly schedule', 'calendar'],
    ['/student/transcript', 'Academic record', 'chart']],
  faculty: [['/faculty', 'Overview', 'grid'], ['/faculty/sections', 'My sections', 'book'],
    ['/catalog/courses', 'Course catalog', 'search']],
  admin: [['/admin', 'Overview', 'grid'], ['/admin/courses', 'Courses', 'book'],
    ['/admin/sections', 'Sections', 'calendar'], ['/admin/users', 'People and access', 'users'],
    ['/admin/reports', 'Reports', 'chart'], ['/catalog/courses', 'Course catalog', 'search']],
}; %>
<div class="app-shell">
  <aside class="sidebar" id="sidebar" aria-label="Main navigation">
    <%- include('brand') %>
    <nav class="nav-list" aria-label="Workspace">
      <% menus[role].forEach(([url, label, icon]) => {
        const active = currentPath === url || (url !== '/' + role && currentPath.startsWith(url + '/')); %>
        <a class="nav-item <%= active ? 'active' : '' %>" href="<%= url %>" <% if (active) { %>aria-current="page"<% } %>>
          <%- include('icon', { name: icon }) %><%= label %>
        </a>
      <% }) %>
    </nav>
    <% if (!user) { %>
      <div class="sidebar-bottom"><a class="button secondary full" href="/auth/login">Sign in</a></div>
    <% } %>
  </aside>
  <button class="menu-scrim" type="button" data-menu-close aria-label="Close navigation" tabindex="-1"></button>
  <div class="workspace">
    <header class="topbar">
      <div class="topbar-left">
        <button class="icon-button mobile-menu" type="button" aria-label="Toggle navigation"
          aria-controls="sidebar" aria-expanded="false" data-menu>
          <%- include('icon', { name: 'menu' }) %>
        </button>
        <span class="breadcrumb"><%= role === 'guest' ? 'Course catalog' : role[0].toUpperCase() + role.slice(1) + ' workspace' %></span>
      </div>
      <div class="topbar-right">
        <span class="term"><span class="status-dot"></span><%= termLabel %></span>
        <% if (preview) { %>
          <label class="sr-only" for="workspace-picker">Preview workspace</label>
          <select id="workspace-picker" data-workspace>
            <% ['student', 'faculty', 'admin'].forEach(workspace => { %>
              <option value="/<%= workspace %>" <%= workspace === role ? 'selected' : '' %>><%= workspace %> preview</option>
            <% }) %>
          </select>
        <% } %>
        <%- include(user ? 'profile-menu' : 'appearance-trigger') %>
      </div>
    </header>
    <main id="main" class="main-content">
      <% if (preview) { %><p class="preview-bar">UI preview · Sample records</p><% } %>
      <% if (notice) { %>
        <p class="notice success-notice" role="status" data-toast-source>
          <%- include('icon', { name: 'check' }) %><%= notice %>
        </p>
      <% } %>
