<% if (!sections.length) { %><p class="empty-state">No sections to display.</p><% } else { %>
<div class="table-wrap">
  <table>
    <caption class="sr-only">Course sections</caption>
    <thead><tr><th>Course / section</th><th>Schedule</th><th>Seats</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody>
      <% sections.forEach(section => { %>
        <tr>
          <td>
            <strong><%= section.course?.code || 'Course unavailable' %> · <%= section.sectionCode %></strong>
            <span class="table-sub"><%= section.course?.title %></span>
            <span class="table-sub"><%= section.term %> · <%= section.faculty?.name || 'Faculty to be assigned' %></span>
          </td>
          <td>
            <% section.schedule.forEach(meeting => { %>
              <span class="table-sub"><%= meeting.day %> <%= formatTime(meeting.start) %>–<%= formatTime(meeting.end) %> · <%= meeting.room || 'Room TBD' %></span>
            <% }) %>
          </td>
          <td>
            <strong><%= section.enrolledCount %> / <%= section.capacity %></strong>
            <meter min="0" max="<%= section.capacity %>" value="<%= section.enrolledCount %>" aria-label="Seats filled"></meter>
          </td>
          <td>
            <% const status = section.status === 'open' && section.enrolledCount >= section.capacity ? 'full' : section.status; %>
            <span class="badge <%= status === 'open' ? 'success' : 'warning' %>"><%= status %></span>
          </td>
          <td>
            <div class="table-actions">
              <% if (role === 'admin') { %>
                <a href="/admin/sections/<%= section._id %>/edit">Edit ↗</a>
                <% if (!preview) { %>
                  <form action="/admin/sections/<%= section._id %>/delete" method="post" data-confirm="Delete this section?"
                    data-confirm-message="Remove section <%= section.sectionCode %> from the schedule for <%= section.term %>?" data-submit>
                    <button class="text-button danger" type="submit">Delete</button>
                  </form>
                <% } %>
              <% } else { %>
                <a href="/faculty/sections/<%= section._id %>/roster">Roster ↗</a>
                <a href="/faculty/sections/<%= section._id %>/grades">Grades ↗</a>
              <% } %>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
