<section class="welcome-banner">
  <div class="banner-copy">
    <h2><%= heading %></h2>
    <p><%= summary %></p>
    <a class="button primary" href="<%= href %>"><%= label %><%- include('icon', { name: 'arrow' }) %></a>
  </div>
  <div class="banner-photo">
    <img src="/images/<%= photo %>" width="1200" height="800" alt="">
  </div>
</section>
