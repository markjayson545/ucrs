<div class="appearance-controls">
  <button type="button" class="icon-button theme-toggle" data-theme-toggle
    aria-label="Dark mode" aria-pressed="false" title="Switch to dark mode" hidden>
    <span class="theme-toggle-icons" aria-hidden="true">
      <span class="theme-icon-light"><%- include('icon', { name: 'sun' }) %></span>
      <span class="theme-icon-dark"><%- include('icon', { name: 'moon' }) %></span>
    </span>
  </button>
  <button type="button" class="button appearance-button" data-appearance-open
    aria-label="Appearance" aria-haspopup="dialog" aria-controls="appearance-dialog" hidden>
    <%- include('icon', { name: 'appearance' }) %><span class="appearance-label">Appearance</span>
  </button>
</div>
