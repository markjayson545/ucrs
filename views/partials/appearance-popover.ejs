<section id="<%= panelId %>" class="appearance-popover" aria-labelledby="<%= panelId %>-title" popover="auto" hidden>
  <h2 id="<%= panelId %>-title">Appearance</h2>
  <form data-appearance-form>
    <fieldset>
      <legend>Theme</legend>
      <div class="theme-options">
        <% [['light', 'Light', 'sun'], ['dark', 'Dark', 'moon'], ['system', 'System', 'monitor']].forEach(([value, label, icon]) => { %>
          <label class="theme-option">
            <input type="radio" name="mode" value="<%= value %>">
            <%- include('icon', { name: icon }) %><span><%= label %></span>
          </label>
        <% }) %>
      </div>
    </fieldset>
    <fieldset>
      <legend>Accent color</legend>
      <div class="accent-options">
        <% ['clay', 'teal', 'indigo', 'plum', 'moss'].forEach(accent => { %>
          <label class="accent-option">
            <input type="radio" name="accent" value="<%= accent %>">
            <span class="accent-swatch" data-swatch="<%= accent %>" aria-hidden="true"></span>
            <span><%= accent[0].toUpperCase() + accent.slice(1) %></span>
          </label>
        <% }) %>
      </div>
    </fieldset>
  </form>
</section>
