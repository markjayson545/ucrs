<dialog id="portal-dialog" aria-labelledby="portal-dialog-title" aria-describedby="portal-dialog-message">
  <h2 id="portal-dialog-title" data-dialog-title>Confirm this change</h2>
  <p id="portal-dialog-message" data-dialog-message></p>
  <form method="dialog" class="form-actions">
    <button class="button secondary" value="cancel" autofocus data-dialog-cancel>Cancel</button>
    <button class="button primary" value="confirm" data-dialog-confirm>Continue</button>
  </form>
</dialog>
