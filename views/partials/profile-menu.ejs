<% const roleLabel = { student: 'Student', faculty: 'Faculty', admin: 'Administrator' }[role]; %>
<% const accountUrl = preview ? '/account?role=' + role : '/account'; %>
<details class="profile-menu" data-profile-menu>
  <summary class="profile-trigger">
    <span class="sr-only">Account menu</span>
    <span class="avatar" aria-hidden="true">
      <% if (user.imageVersion) { %><img src="<%= images.profilePhoto(user) %>" alt=""><% } else { %><%= images.initials(user.name) %><% } %>
    </span>
    <span class="profile-trigger-name" aria-hidden="true"><%= user.name %></span>
    <span class="profile-chevron"><%- include('icon', { name: 'chevron' }) %></span>
  </summary>
  <div class="profile-popup">
    <div class="profile-identity">
      <strong><%= user.name %></strong>
      <span><%= user.email %></span>
      <small><%= roleLabel %></small>
    </div>
    <div class="profile-quick">
      <p>Quick settings</p>
      <%- include('appearance-trigger', { quickSwitch: true }) %>
    </div>
    <nav class="profile-links" aria-label="Account">
      <a href="/<%= role %>"><%- include('icon', { name: 'grid' }) %>Workspace overview</a>
      <a href="<%= accountUrl %>" <% if (currentPath === '/account' || currentPath === '/student/profile') { %>aria-current="page"<% } %>>
        <%- include('icon', { name: 'user' }) %>Account settings
      </a>
      <% if (preview) { %>
        <a href="/"><%- include('icon', { name: 'arrow' }) %>Exit preview</a>
      <% } else { %>
        <% const signOutPrompt = 'Sign out of this browser?'; %>
        <form action="/auth/logout" method="post" data-confirm="<%= signOutPrompt %>"
          data-confirm-message="Any unsaved changes on this page will be lost.">
          <details data-confirm-disclosure>
            <summary><span>Sign out</span><span>Cancel sign-out</span></summary>
            <p><%= signOutPrompt %></p>
            <button type="submit"><%- include('icon', { name: 'logout' }) %>Sign out</button>
          </details>
        </form>
      <% } %>
    </nav>
  </div>
</details>
