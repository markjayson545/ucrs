<% const fieldName = 'meetings[' + index + ']'; %>
<fieldset class="meeting-fields" data-meeting>
  <legend data-meeting-title>Meeting <%= Number(index) + 1 || '' %></legend>
  <div class="form-grid">
    <div>
      <label for="day-<%= index %>">Day</label>
      <select id="day-<%= index %>" name="<%= fieldName %>[day]" data-meeting-field="day">
        <% const dayLabels = { MON: 'Monday', TUE: 'Tuesday', WED: 'Wednesday', THU: 'Thursday', FRI: 'Friday', SAT: 'Saturday' }; %>
        <% days.forEach(day => { %>
          <option value="<%= day %>" <%= meeting.day === day ? 'selected' : '' %>><%= dayLabels[day] %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label for="room-<%= index %>">Room <span class="optional">(optional)</span></label>
      <input id="room-<%= index %>" name="<%= fieldName %>[room]" value="<%= meeting.room || '' %>" placeholder="Tech 301" data-meeting-field="room">
    </div>
    <div>
      <label for="start-<%= index %>">Starts at</label>
      <input id="start-<%= index %>" name="<%= fieldName %>[start]" type="time" value="<%= formatTime(meeting.start) %>"
        pattern="(?:[01][0-9]|2[0-3]):[0-5][0-9]" required data-start data-meeting-field="start">
    </div>
    <div>
      <label for="end-<%= index %>">Ends at</label>
      <input id="end-<%= index %>" name="<%= fieldName %>[end]" type="time"
        value="<%= meeting.end === 1440 ? '' : formatTime(meeting.end) %>" aria-describedby="end-error-<%= index %>"
        pattern="(?:[01][0-9]|2[0-3]):[0-5][0-9]" data-end data-meeting-field="end">
      <p id="end-error-<%= index %>" class="field-hint field-error" data-end-error hidden></p>
      <label class="checkbox-label meeting-midnight">
        <input type="checkbox" name="<%= fieldName %>[endsAtMidnight]" value="1" <%= meeting.end === 1440 ? 'checked' : '' %> data-midnight>
        Ends at midnight
      </label>
    </div>
  </div>
  <button class="text-button danger" type="button" data-remove-meeting hidden>Remove meeting</button>
</fieldset>
