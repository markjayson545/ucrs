<div>
  <label for="confirm-password"><%= fieldLabel %></label>
  <div class="password-field">
    <input id="confirm-password" name="confirmPassword" type="password" autocomplete="new-password"
      data-match-password="<%= sourceId %>" aria-describedby="password-match-error" required>
    <button type="button" data-password="confirm-password" aria-controls="confirm-password" aria-label="Show password confirmation" hidden>Show</button>
  </div>
  <p id="password-match-error" class="field-hint field-error" aria-live="polite" hidden></p>
</div>
