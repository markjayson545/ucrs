<%- include('../partials/header') %>
<%- include('../partials/page-heading', { eyebrow: 'STUDENT WORKSPACE', description: 'Review completed courses and your credit-weighted GPA.' }) %>
<div class="stats-grid compact">
  <% [['Cumulative GPA', transcript.gpa?.toFixed(2) ?? '—'], ['Graded credits', transcript.credits], ['Completed courses', transcript.records.length]].forEach(([label, value]) => { %>
    <article class="stat-card"><span><%= label %></span><strong><%= value %></strong></article>
  <% }) %>
</div>
<section class="panel">
  <div class="panel-heading"><h2>Course history</h2></div>
  <% if (!transcript.records.length) { %><p class="empty-state">Your grades will appear here after faculty submit them.</p><% } else { %>
    <div class="table-wrap">
      <table>
        <caption class="sr-only">Academic record</caption>
        <thead><tr><th>Term</th><th>Course</th><th>Credits</th><th>Grade</th><th>Grade points</th></tr></thead>
        <tbody>
          <% transcript.records.forEach(record => { %>
            <tr>
              <td><%= record.term %></td>
              <td><strong><%= record.code %></strong><span class="table-sub"><%= record.title %></span></td>
              <td><%= record.credits %></td>
              <td><span class="badge"><%= record.letter %></span></td>
              <td><%= record.points.toFixed(2) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
  <p class="table-note">Contact the registrar for an official transcript.</p>
</section>
<%- include('../partials/footer') %>
