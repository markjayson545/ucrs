<%- include('../partials/header') %>
<%- include('../partials/page-heading', { eyebrow: 'STUDENT WORKSPACE', description: 'Your weekly class times and rooms for ' + term + '.', action: { href: '/student/enrollments', label: 'My enrollments', icon: 'book' } }) %>
<% if (meetings.some(({ enrollment }) => enrollment.status === 'waitlisted')) { %>
  <p class="notice">Waitlisted classes appear here so you can plan your week. Your seat is confirmed when you are promoted.</p>
<% } %>
<section class="panel">
  <div class="panel-heading"><h2><%= termLabel %></h2><%- include('../partials/enrollment-summary') %></div>
  <div class="week-grid">
    <% const labels = { MON: 'Monday', TUE: 'Tuesday', WED: 'Wednesday', THU: 'Thursday', FRI: 'Friday', SAT: 'Saturday' }; %>
    <% days.forEach(day => {
      const dayMeetings = meetings.filter(({ meeting }) => meeting.day === day); %>
      <section class="week-day">
        <h3><%= labels[day] %></h3>
        <% if (!dayMeetings.length) { %><p class="free-day">No scheduled classes</p><% } %>
        <% dayMeetings.forEach(({ enrollment, meeting }) => { %>
          <article class="week-class <%= enrollment.course?.color || 'blue' %>" data-arrival>
            <span class="eyebrow"><%= formatTime(meeting.start) %>–<%= formatTime(meeting.end) %></span>
            <% if (enrollment.course) { %>
              <h4><a href="/catalog/courses/<%= enrollment.course._id %>"><%= enrollment.course.code %></a></h4>
              <p><%= enrollment.course.title %></p>
            <% } %>
            <small><%= meeting.room || 'Room TBD' %> · <%= enrollment.section.sectionCode %></small>
            <% if (enrollment.status === 'waitlisted') { %><span class="badge warning">Waitlisted</span><% } %>
          </article>
        <% }) %>
      </section>
    <% }) %>
  </div>
</section>
<%- include('../partials/footer') %>
