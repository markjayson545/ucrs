<%- include('../partials/header') %> <%- include('../partials/page-heading', { eyebrow: 'YOUR SEMESTER, AT A GLANCE', description: 'Welcome back, Alex. Here’s a little clarity for the week ahead.', action: { href: '/catalog/courses', label: 'Explore courses', icon: 'search' } }) %>
<section class="welcome-banner">
  <div>
    <span class="eyebrow">A NEW SEMESTER. NEW POSSIBILITIES.</span>
    <h2>Find your rhythm.<br />Make it your semester.</h2>
    <p>Your next big idea could be one class away.</p>
    <a class="button light" href="/catalog/courses"
      >Find your next course <%- include('../partials/icon', { name: 'arrow' }) %></a
    >
  </div>
  <div class="welcome-art" aria-hidden="true">
    <div class="art-circle"></div>
    <div class="art-book"></div>
    <span>KEEP<br />GROWING.</span>
  </div>
</section>
<div class="stats-grid">
  <% [['Active credits','9','Across 3 enrolled courses','book'],['Enrolled courses','3','One more on your waitlist','check'],['Previous term GPA','3.75','12 credits completed','chart'],['This week','4','Scheduled class meetings','calendar']].forEach(([label,value,hint,icon]) => { %>
  <article class="stat-card">
    <div class="row-between">
      <span><%= label %></span
      ><span class="stat-icon"
        ><%- include('../partials/icon', { name: icon }) %></span
      >
    </div>
    <strong><%= value %></strong><small><%= hint %></small>
  </article>
  <% }) %>
</div>
<div class="dashboard-grid">
  <section class="panel">
    <div class="panel-heading">
      <div>
        <span class="eyebrow">ON YOUR CALENDAR</span>
        <h2>Your week, in focus</h2>
      </div>
      <a class="text-link" href="/student/schedule">Full schedule ↗</a>
    </div>
    <% sections.slice(0,3).forEach((s,i) => { %>
    <div class="class-row">
      <div class="day-tile">
        <small><%= s.schedule[0].day %></small
        ><strong><%= String(i + 1).padStart(2,'0') %></strong>
      </div>
      <div class="class-info">
        <a href="/catalog/courses/<%= s.course._id %>"><%= s.course.title %></a
        ><span
          ><%= s.course.code %> · Section <%= s.sectionCode %> · <%= s.schedule[0].room %></span
        >
      </div>
      <div class="class-time">
        <%= formatTime(s.schedule[0].start) %><small
          ><%= formatTime(s.schedule[0].end) %></small
        >
      </div>
    </div>
    <% }) %>
  </section>
  <aside class="panel semester-panel">
    <span class="eyebrow">ONE STEP CLOSER</span>
    <h2>A strong start.</h2>
    <div class="credit-ring">
      <strong>9<span>active credits</span></strong>
    </div>
    <p>You’ve enrolled in 3 courses. Keep an eye on your waitlisted section.</p>
    <a href="/student/enrollments" class="button secondary full"
      >Review enrollments <%- include('../partials/icon', { name: 'arrow' }) %></a
    >
  </aside>
</div>
<div class="section-heading">
  <div>
    <span class="eyebrow">ROOM FOR CURIOSITY</span>
    <h2>A few courses to explore</h2>
  </div>
  <a class="text-link" href="/catalog/courses">View all courses ↗</a>
</div>
<div class="course-grid">
  <% courses.slice(3).forEach(course => { %><%- include('../partials/course-card', { course }) %><% }) %>
</div>
<%- include('../partials/footer') %>
