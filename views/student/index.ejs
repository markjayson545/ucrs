<%- include('../partials/header') %>
<%- include('../partials/page-heading', { eyebrow: 'STUDENT WORKSPACE', description: 'Welcome back, ' + user.name + '.', action: { href: '/catalog/courses', label: 'Explore courses', icon: 'search' } }) %>
<%- include('../partials/workspace-banner', {
  heading: 'Your semester at a glance',
  summary: 'Review the classes and waitlist places you are tracking this term.',
  href: '/student/enrollments', label: 'My enrollments', photo: 'library-study.webp'
}) %>
<div class="stats-grid">
  <% stats.forEach(([label, value, icon]) => { %>
    <article class="stat-card">
      <div class="row-between">
        <span><%= label %></span><span class="stat-icon"><%- include('../partials/icon', { name: icon }) %></span>
      </div>
      <strong><%= value %></strong>
    </article>
  <% }) %>
</div>
<section class="panel">
  <div class="panel-heading">
    <h2>Weekly meetings</h2>
    <a class="text-link" href="/student/schedule">Full schedule ↗</a>
  </div>
  <% if (!meetings.length) { %><p class="empty-state">Your confirmed classes will appear here when you enroll.</p><% } %>
  <% meetings.slice(0, 4).forEach(({ enrollment, meeting }) => { %>
    <div class="class-row" data-arrival>
      <div class="day-tile"><strong><%= meeting.day %></strong></div>
      <div class="class-info">
        <a href="/catalog/courses/<%= enrollment.course._id %>"><%= enrollment.course.title %></a>
        <span><%= enrollment.course.code %> · <%= meeting.room || 'Room TBD' %></span>
      </div>
      <div class="class-time"><%= formatTime(meeting.start) %><small><%= formatTime(meeting.end) %></small></div>
    </div>
  <% }) %>
</section>
<% if (courses.length) { %>
  <div class="section-heading"><h2>Courses to explore</h2><a class="text-link" href="/catalog/courses">View all courses ↗</a></div>
  <div class="course-grid">
    <% courses.forEach(course => { %><%- include('../partials/course-card', { course }) %><% }) %>
  </div>
<% } %>
<%- include('../partials/footer') %>
