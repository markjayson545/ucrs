<%- include('../partials/head') %>
<main id="main" class="auth-layout">
  <section class="auth-panel">
    <nav class="auth-nav" aria-label="Account navigation">
      <%- include('../partials/brand') %>
      <%- include('../partials/appearance-trigger') %>
    </nav>
    <div class="auth-form-wrap">
      <% const draft = typeof registrationDraft === 'undefined' ? {} : registrationDraft; %>
      <h1>Create an account</h1>
      <p>Student accounts can browse courses, enroll, and track grades.</p>
      <form id="register-form" action="/auth/register" method="post"
        <% if (preview) { %>data-preview-form inert<% } else { %>data-auth data-pending="Creating your account…" data-success="/auth/login?registered=1"<% } %>>
        <% if (typeof registrationError === 'string') { %>
          <p class="form-feedback" data-kind="error" role="alert"><%= registrationError %></p>
        <% } %>
        <label for="name">Full name</label>
        <input id="name" name="name" value="<%= draft.name || '' %>" autocomplete="name" maxlength="100" required>
        <label for="email">University email</label>
        <input id="email" name="email" type="email" value="<%= draft.email || '' %>" autocomplete="email" placeholder="you@example.edu" required>
        <div class="form-grid">
          <div>
            <label for="idNumber">Student ID <span class="optional">(optional)</span></label>
            <input id="idNumber" name="idNumber" value="<%= draft.idNumber || '' %>" maxlength="50" placeholder="2026-00101">
          </div>
          <div>
            <label for="department">Department <span class="optional">(optional)</span></label>
            <input id="department" name="department" value="<%= draft.department || '' %>" maxlength="100" list="department-suggestions">
            <datalist id="department-suggestions">
              <option value="Computer Science"></option><option value="Mathematics"></option><option value="Humanities"></option>
            </datalist>
          </div>
        </div>
        <label for="password">Password</label>
        <div class="password-field">
          <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" aria-describedby="password-hint" required>
          <button type="button" data-password="password" aria-controls="password" aria-label="Show password" hidden>Show</button>
        </div>
        <p id="password-hint" class="field-hint">Use at least 8 characters.</p>
        <%- include('../partials/confirm-password', { sourceId: 'password', fieldLabel: 'Confirm password' }) %>
        <button class="button primary full" type="submit" <%= preview ? 'disabled' : '' %>>
          Create student account <%- include('../partials/icon', { name: 'arrow' }) %>
        </button>
        <p class="form-feedback" role="status" hidden></p>
      </form>
      <p class="auth-switch">Already have an account? <a href="/auth/login">Sign in</a></p>
    </div>
  </section>
  <%- include('../partials/auth-story', { photo: 'library-study.webp', message: 'Your next semester starts here.' }) %>
</main>
<% if (!preview) { %><script src="/javascripts/auth.js" defer></script><% } %>
<%- include('../partials/auth-end') %>
