<%- include('../partials/head') %>
<main id="main" class="auth-layout">
  <section class="auth-story">
    <a class="brand" href="/"
      ><span class="brand-mark"
        ><%- include('../partials/icon', { name: 'book' }) %></span
      ><span>UCRS<span class="brand-sub">CAMPUS CONNECTED</span></span></a
    >
    <div>
      <p class="eyebrow">A NEW BEGINNING.</p>
      <h1>Big ideas.<br />Fresh starts.<br /><em>Your place.</em></h1>
      <p>
        Make space for what comes next. Your academic journey starts with a
        connection.
      </p>
      <div class="auth-art" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
    </div>
    <small>University Course Registration System</small>
  </section>
  <section class="auth-panel">
    <a class="back-link" href="/">← Back to campus</a>
    <div class="auth-form-wrap">
      <h2>Find your place.</h2>
      <p>Create your student account to get started.</p>
      <form
        action="/auth/register"
        method="POST"
        id="register-form"
      >
        <label for="name">Full name</label
        ><input
          id="name"
          name="name"
          autocomplete="name"
          maxlength="100"
          placeholder="Alex Morgan"
          required
        /><label for="email">University email</label
        ><input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="you@example.edu"
          required
        />
        <div class="form-grid">
          <div>
            <label for="idNumber"
              >Student ID <span class="optional">(optional)</span></label
            ><input id="idNumber" name="idNumber" placeholder="2026-00101" />
          </div>
          <div>
            <label for="department">Department</label
            ><select id="department" name="department" required>
              <option value="">Select department</option>
              <option>Computer Science</option>
              <option>Mathematics</option>
              <option>Humanities</option>
            </select>
          </div>
        </div>
        <label for="password">Password</label>
        <div class="password-field">
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="new-password"
            minlength="8"
            aria-describedby="password-hint"
            required
          /><button
            type="button"
            data-password="password"
            aria-label="Show password"
            aria-pressed="false"
          >
            Show
          </button>
        </div>
        <p id="password-hint" class="field-hint">
          Use at least 8 characters. This preview does not create an account.
        </p>
        <button type="submit" class="button primary full">
          Create student account <%- include('../partials/icon', { name: 'arrow' }) %>
        </button>
        <p class="form-feedback" role="status" hidden></p>
      </form>
      <p class="auth-switch">
        Already part of campus? <a href="/auth/login">Sign in</a>
      </p>
    </div>
  </section>
</main>
<script src="/javascripts/register.js" defer></script>
<%- include('../partials/auth-end') %>
