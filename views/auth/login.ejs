<%- include('../partials/head') %>
<main id="main" class="auth-layout">
  <section class="auth-panel">
    <nav class="auth-nav" aria-label="Account navigation">
      <%- include('../partials/brand') %>
      <%- include('../partials/appearance-trigger') %>
    </nav>
    <div class="auth-form-wrap">
      <h1>Sign in</h1>
      <p>Use your campus account to open your workspace.</p>
      <form id="login-form" action="/auth/session" method="post"
        <% if (preview) { %>data-preview-form inert<% } else { %>data-auth data-pending="Signing in…"<% } %>>
        <label for="email">University email</label>
        <input id="email" name="email" type="email" autocomplete="username" placeholder="you@example.edu" required>
        <label for="password">Password</label>
        <div class="password-field">
          <input id="password" name="password" type="password" autocomplete="current-password" required>
          <button type="button" data-password="password" aria-pressed="false" aria-label="Show password">Show</button>
        </div>
        <button class="button primary full" type="submit" <%= preview ? 'disabled' : '' %>>
          Sign in <%- include('../partials/icon', { name: 'arrow' }) %>
        </button>
        <% const registered = typeof registrationComplete !== 'undefined' && registrationComplete; %>
        <p class="form-feedback" role="status" <% if (!registered) { %>hidden<% } %>><%= registered ? 'Account created. You can sign in now.' : '' %></p>
      </form>
      <p class="auth-switch">New student? <a href="/auth/register">Create an account</a></p>
    </div>
  </section>
  <%- include('../partials/auth-story', { photo: 'campus-courtyard.webp', message: 'Find your place on campus.' }) %>
</main>
<% if (!preview) { %><script src="/javascripts/auth.js" defer></script><% } %>
<%- include('../partials/auth-end') %>
