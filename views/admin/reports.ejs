<%- include('../partials/header') %>
<%- include('../partials/page-heading', { eyebrow: 'ADMINISTRATION', description: 'See how many seats are filled and where students are waiting for space.' }) %>
<div class="stats-grid">
  <% [['Total capacity', report.capacity], ['Seats taken', report.enrolled], ['Seats remaining', report.available], ['Waitlisted registrations', report.waitlisted]].forEach(([label, value]) => { %>
    <article class="stat-card"><span><%= label %></span><strong><%= value %></strong></article>
  <% }) %>
</div>
<section class="panel">
  <div class="panel-heading"><h2>Enrollment by section</h2><span class="badge"><%= term %> · <%= report.utilization %>% filled</span></div>
  <% if (!report.sections.length) { %><p class="empty-state">No sections are scheduled for this term.</p><% } %>
  <% report.sections.forEach(section => { %>
    <div class="report-row">
      <div class="row-between"><strong><%= section.course?.code || 'Course unavailable' %> · <%= section.sectionCode %></strong><span><%= section.enrolledCount %> / <%= section.capacity %></span></div>
      <meter data-meter min="0" max="<%= section.capacity %>" value="<%= section.enrolledCount %>" aria-label="Seat occupancy"></meter>
      <small class="muted"><%= section.capacity - section.enrolledCount %> seats remaining · <%= section.waitlisted %> waitlisted</small>
    </div>
  <% }) %>
  <p class="table-note">Totals count seats across sections, so a student can account for more than one seat.</p>
</section>
<%- include('../partials/footer') %>
