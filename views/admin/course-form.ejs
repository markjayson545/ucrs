<%- include('../partials/header') %>
<a class="back-link" href="/admin/courses">← Course management</a>
<%- include('../partials/page-heading', { eyebrow: 'ADMINISTRATION', description: 'Set the details students will see in the catalog.' }) %>
<form class="panel form-panel" method="post" enctype="multipart/form-data" action="<%= course ? '/admin/courses/' + course._id + '/edit' : '/admin/courses' %>"
  <% if (preview) { %>data-preview-form inert<% } else { %>data-submit<% } %>>
  <div class="form-feedback" aria-live="polite" hidden></div>
  <div class="form-grid">
    <div>
      <label for="code">Course code</label>
      <input id="code" name="code" value="<%= course?.code || '' %>" placeholder="CS 301" required
        <% if (course) { %>readonly aria-describedby="code-hint"<% } %>>
      <% if (course) { %><p id="code-hint" class="field-hint">Course codes stay fixed after creation.</p><% } %>
    </div>
    <div>
      <label for="credits">Credits</label>
      <input id="credits" name="credits" type="number" min="1" max="6" step="1" value="<%= course?.credits ?? 3 %>"
        aria-describedby="credits-hint" required>
      <p id="credits-hint" class="field-hint">Enter a whole number from 1 to 6.</p>
    </div>
    <div><label for="title">Course title</label><input id="title" name="title" value="<%= course?.title || '' %>" required></div>
    <div><label for="department">Department</label><input id="department" name="department" value="<%= course?.department || '' %>" required></div>
  </div>
  <label for="description">Description <span class="optional">(optional)</span></label>
  <textarea id="description" name="description" rows="5"><%= course?.description || '' %></textarea>
  <%- include('../partials/image-editor', { kind: 'course', record: course }) %>
  <% const choices = courses.filter(candidate => !course || String(candidate._id) !== String(course._id)); %>
  <% if (choices.length) { %>
    <fieldset data-option-group>
      <legend>Prerequisite courses <span class="optional">(optional)</span></legend>
      <%- include('../partials/field-filter', {
        filterId: 'prerequisite-filter', filterLabel: 'Find prerequisite courses', filterHint: 'Course code or title', filterTarget: 'prerequisite-options'
      }) %>
      <div id="prerequisite-options" class="check-grid">
        <% choices.forEach(candidate => { %>
          <label class="checkbox-label" data-option>
            <input id="prerequisite-<%= candidate._id %>" type="checkbox" name="prerequisites" value="<%= candidate._id %>"
              <%= course?.prerequisites.some(prerequisite => prerequisite.code === candidate.code) ? 'checked' : '' %>>
            <span><strong><%= candidate.code %></strong> · <%= candidate.title %></span>
          </label>
        <% }) %>
      </div>
    </fieldset>
  <% } %>
  <div class="form-actions">
    <button type="submit" class="button primary" <%= preview ? 'disabled' : '' %>><%= preview ? 'Preview course' : 'Save course' %></button>
    <a class="button secondary" href="/admin/courses">Cancel</a>
  </div>
</form>
<%- include('../partials/footer') %>
