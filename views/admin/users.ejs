<%- include('../partials/header') %> <%- include('../partials/page-heading', { eyebrow: 'THE PEOPLE BEHIND CAMPUS', description: 'A connected community starts with the people in it.' }) %>
<section class="panel">
  <div class="panel-heading">
    <h2>Campus directory</h2>
    <label class="sr-only" for="people-search">Search people</label
    ><input
      id="people-search"
      type="search"
      placeholder="Search people…"
      data-table-search="people-table"
    />
  </div>
  <div class="table-wrap">
    <table id="people-table">
      <caption class="sr-only">
        Sample campus directory
      </caption>
      <thead>
        <tr>
          <th>Name / email</th>
          <th>Student ID</th>
          <th>Department</th>
          <th>Role</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% students.forEach(s => { %>
        <tr>
          <td>
            <strong><%= s.name %></strong
            ><span class="table-sub"><%= s.email %></span>
          </td>
          <td><%= s.idNumber %></td>
          <td><%= s.department %></td>
          <td><span class="badge"><%= s.role %></span></td>
          <td>
            <span class="badge success"
              ><%= s.isActive ? 'Active' : 'Inactive' %></span
            >
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="empty-state" data-empty-for="people-table" hidden>
    No people match your search.
  </p>
</section>
<%- include('../partials/footer') %>
