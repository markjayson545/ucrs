<%- include('../partials/header') %>
<%- include('../partials/page-heading', { eyebrow: 'ADMINISTRATION', description: 'Assign faculty roles and control access to campus accounts.' }) %>
<section class="panel">
  <div class="panel-heading">
    <h2>Campus directory</h2>
    <%- include('../partials/table-search', { inputId: 'people-search', label: 'Search people', hint: 'Name, email, ID, or role', tableId: 'people-table' }) %>
  </div>
  <div class="table-wrap">
    <table id="people-table">
      <caption class="sr-only">Campus accounts</caption>
      <thead><tr><th>Name / email</th><th>Campus ID</th><th>Department</th><th>Role and status</th></tr></thead>
      <tbody>
        <% people.forEach(person => { %>
          <tr data-search-row="<%= [person.name, person.email, person.idNumber, person.department, person.role].join(' ') %>">
            <td>
              <div class="table-identity">
                <span class="avatar directory-avatar" aria-hidden="true">
                  <%= images.initials(person.name) %>
                  <% if (person.imageVersion) { %>
                    <img src="/admin/users/<%= person._id %>/photo?v=<%= person.imageVersion %>"
                      width="40" height="40" alt="" loading="lazy" data-image-fallback="">
                  <% } %>
                </span>
                <span><strong><%= person.name %></strong><span class="table-sub"><%= person.email %></span></span>
              </div>
            </td>
            <td><%= person.idNumber || '—' %></td><td><%= person.department || '—' %></td>
            <td>
              <% if (preview || person.role === 'admin') { %>
                <span class="badge"><%= person.role %></span><span class="badge"><%= person.isActive ? 'Active' : 'Inactive' %></span>
              <% } else { %>
                <form action="/admin/users/<%= person._id %>/access" method="post" class="table-actions" data-submit>
                  <select name="role" aria-label="Role for <%= person.name %>">
                    <option value="student" <%= person.role === 'student' ? 'selected' : '' %>>Student</option>
                    <option value="faculty" <%= person.role === 'faculty' ? 'selected' : '' %>>Faculty</option>
                  </select>
                  <select name="isActive" aria-label="Account status for <%= person.name %>">
                    <option value="true" <%= person.isActive ? 'selected' : '' %>>Active</option>
                    <option value="false" <%= person.isActive ? '' : 'selected' %>>Inactive</option>
                  </select>
                  <button type="submit" class="button secondary">Save access</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/table-search-count', { tableId: 'people-table' }) %>
  <p class="empty-state" data-empty-for="people-table" hidden>No people match your search.</p>
</section>
<%- include('../partials/footer') %>
