<%- include('../partials/header') %> <%- include('../partials/page-heading', { eyebrow: 'THE ADMINISTRATION WORKSPACE', description: 'Keep the academic essentials organized, so everyone can move forward.', action: { href: '/admin/courses/new', label: 'Create a course' } }) %>
<section class="welcome-banner">
  <div>
    <span class="eyebrow">A CLEARER VIEW OF CAMPUS</span>
    <h2>Good foundations.<br />Better possibilities.</h2>
    <p>Courses, people, and planning. Connected.</p>
    <a class="button light" href="/admin/reports"
      >Explore semester reports <%- include('../partials/icon', { name: 'arrow' }) %></a
    >
  </div>
  <div class="welcome-art" aria-hidden="true">
    <div class="art-circle"></div>
    <div class="art-book"></div>
    <span>MAKE<br />CONNECTIONS.</span>
  </div>
</section>
<div class="stats-grid">
  <% [['Courses',courses.length,'Across 3 departments'],['Open sections',sections.length,'First semester'],['Section enrollments','117','Sample occupancy total'],['Seat utilization','84%','117 of 140 seats filled']].forEach(([label,value,hint]) => { %>
  <article class="stat-card">
    <span><%= label %></span><strong><%= value %></strong
    ><small><%= hint %></small>
  </article>
  <% }) %>
</div>
<div class="three-grid">
  <% [['/admin/courses','Course catalog','Create and organize the building blocks of a degree.','book'],['/admin/sections','Section planning','Coordinate capacity, faculty, and classroom schedules.','calendar'],['/admin/users','People & access','Review the people who make your campus possible.','users']].forEach(([url,label,desc,icon]) => { %><a href="<%= url %>" class="portal-card"
    ><span class="mini-icon"
      ><%- include('../partials/icon', { name: icon }) %></span
    >
    <h2><%= label %></h2>
    <p><%= desc %></p>
    <span class="text-link">Open workspace ↗</span></a
  ><% }) %>
</div>
<%- include('../partials/footer') %>
