<%- include('../partials/header') %>
<%- include('../partials/page-heading', { eyebrow: 'ADMINISTRATION', description: 'Manage the course catalog, teaching sections, and accounts.', action: { href: '/admin/courses/new', label: 'Create a course' } }) %>
<%- include('../partials/workspace-banner', {
  heading: 'Enrollment at a glance',
  summary: 'Review seat capacity and waitlists for ' + term + '.',
  href: '/admin/reports', label: 'Enrollment reports', photo: 'campus-courtyard.webp'
}) %>
<div class="stats-grid">
  <% [['Catalog courses', courseCount], ['Open sections', report.openSections], ['Seats taken', report.enrolled], ['Seat utilization', report.utilization + '%']].forEach(([label, value]) => { %>
    <article class="stat-card"><span><%= label %></span><strong><%= value %></strong></article>
  <% }) %>
</div>
<div class="three-grid">
  <% [['/admin/courses', 'Courses', 'Create and update courses and prerequisites.', 'book'],
      ['/admin/sections', 'Sections', 'Assign faculty, meeting times, and seat capacity.', 'calendar'],
      ['/admin/users', 'People and access', 'Review accounts and manage roles.', 'users']].forEach(([url, label, description, icon]) => { %>
    <a href="<%= url %>" class="portal-card">
      <span class="mini-icon"><%- include('../partials/icon', { name: icon }) %></span>
      <h2><%= label %></h2><p><%= description %></p><span class="text-link">Manage <%= label.toLowerCase() %> ↗</span>
    </a>
  <% }) %>
</div>
<%- include('../partials/footer') %>
