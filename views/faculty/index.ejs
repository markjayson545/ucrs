<%- include('../partials/header') %>
<%- include('../partials/page-heading', { eyebrow: 'FACULTY WORKSPACE', description: 'View your assignments for ' + term + ' and open a roster or gradebook.', action: { href: '/faculty/sections', label: 'All teaching sections', icon: 'book' } }) %>
<%- include('../partials/workspace-banner', {
  heading: 'Your teaching this term',
  summary: 'Open a section below to review its roster or publish grades.',
  href: '#current-sections', label: 'See current sections', photo: 'teaching-studio.webp'
}) %>
<div class="stats-grid compact">
  <% [['Teaching sections', sections.length], ['Seats taken', sections.reduce((sum, section) => sum + section.enrolledCount, 0)], ['Weekly meetings', sections.reduce((sum, section) => sum + section.schedule.length, 0)]].forEach(([label, value]) => { %>
    <article class="stat-card"><span><%= label %></span><strong><%= value %></strong></article>
  <% }) %>
</div>
<section class="panel" id="current-sections">
  <div class="panel-heading"><h2>Current teaching sections</h2><span class="badge"><%= term %></span></div>
  <%- include('../partials/section-table') %>
</section>
<%- include('../partials/footer') %>
