<%- include('../partials/header') %>
<%- include('../partials/page-heading', { eyebrow: termLabel, description: 'Search by course code or title, or browse by department.' }) %>
<% const filtered = Boolean(q || department); %>
<form class="filter-bar" action="/catalog/courses" method="get">
  <div class="search-field">
    <label for="q">Course name or code</label>
    <input id="q" name="q" value="<%= q %>" maxlength="100" placeholder="Search by course name or code…" type="search">
  </div>
  <div>
    <label for="department">Department</label>
    <select id="department" name="department">
      <option value="">All departments</option>
      <% departments.forEach(name => { %>
        <option <%= department === name ? 'selected' : '' %>><%= name %></option>
      <% }) %>
    </select>
  </div>
  <button class="button primary" type="submit"><%- include('../partials/icon', { name: 'search' }) %> Find courses</button>
</form>
<% if (!filtered) { %>
  <aside class="catalog-banner">
    <p>Choose a course to compare section times, available seats, and prerequisites.</p>
    <div class="banner-photo"><img src="/images/library-study.webp" width="1200" height="800" alt=""></div>
  </aside>
<% } %>
<div class="section-heading">
  <h2><%= filtered ? 'Search results' : 'All courses' %> <span class="count" <% if (filtered && courses.length) { %>data-result-cue<% } %>><%= meta.total %></span></h2>
  <% if ((q || department) && courses.length) { %><a class="text-link" href="/catalog/courses">Clear filters</a><% } %>
</div>
<% if (courses.length) { %>
  <div class="course-grid">
    <% courses.forEach(course => { %><%- include('../partials/course-card', { course }) %><% }) %>
  </div>
<% } else { %>
  <div class="empty-state">
    <%- include('../partials/icon', { name: 'search' }) %>
    <% if (filtered) { %>
      <h2 data-result-cue>No courses found</h2><p>Try another keyword or browse all departments.</p>
      <a class="button secondary" href="/catalog/courses">Clear filters</a>
    <% } else if (meta.total) { %>
      <h2>No courses on this page</h2><a class="button secondary" href="/catalog/courses">Back to first page</a>
    <% } else { %>
      <h2>No courses in the catalog yet</h2>
      <% if (role === 'admin') { %><a class="button secondary" href="/admin/courses/new">Create a course</a><% } %>
    <% } %>
  </div>
<% } %>
<% if (meta.pages > 1) { %>
  <nav class="form-actions" aria-label="Catalog pages">
    <% if (meta.page > 1) { %><a class="button secondary" href="<%= pageLink(meta.page - 1) %>">Previous</a><% } %>
    <span class="muted">Page <%= meta.page %> of <%= meta.pages %></span>
    <% if (meta.page < meta.pages) { %><a class="button secondary" href="<%= pageLink(meta.page + 1) %>">Next</a><% } %>
  </nav>
<% } %>
<%- include('../partials/footer') %>
