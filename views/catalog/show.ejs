<%- include('../partials/header') %>
<a class="back-link" href="/catalog/courses">← Course catalog</a>
<div class="detail-hero">
  <div>
    <p class="eyebrow"><%= course.department %> / <%= course.code %></p>
    <h1><%= course.title %></h1>
    <p><%= course.description %></p>
    <div class="chips">
      <span class="badge"><%= course.credits %> credits</span>
      <span class="badge"><%= course.prerequisites.length ? 'Prerequisites apply' : 'No prerequisites' %></span>
      <% if (role === 'admin') { %><a class="text-link" href="/admin/courses/<%= course._id %>/edit">Edit course</a><% } %>
    </div>
  </div>
  <div class="detail-photo"><%- include('../partials/course-photo', { course }) %></div>
</div>
<div class="content-split">
  <section class="panel">
    <div class="panel-heading">
      <div class="chips"><h2>Course sections</h2><span class="badge"><%= term %></span></div>
      <% if (role === 'student') { %><a class="text-link" href="/student/schedule">View my schedule ↗</a><% } %>
    </div>
    <% if (!sections.length) { %><p class="empty-state">No sections are scheduled for this term.</p><% } %>
    <% sections.forEach(section => {
      const full = section.enrolledCount >= section.capacity;
      const open = section.status === 'open'; %>
      <article class="section-option" data-arrival>
        <div class="row-between">
          <h3>Section <%= section.sectionCode %></h3>
          <span class="badge <%= open && !full ? 'success' : 'warning' %>">
            <%= open ? (full ? 'Waitlist available' : 'Seats available') : 'Registration closed' %>
          </span>
        </div>
        <dl class="section-facts">
          <div>
            <dt>Meetings</dt>
            <% if (!section.schedule.length) { %><dd>Time TBD</dd><% } %>
            <% section.schedule.forEach(meeting => { %>
              <dd><%= meeting.day %> · <%= formatTime(meeting.start) %>–<%= formatTime(meeting.end) %>
                <span class="table-sub"><%= meeting.room || 'Room TBD' %></span></dd>
            <% }) %>
          </div>
          <div><dt>Instructor</dt><dd><%= section.faculty?.name || 'To be assigned' %></dd></div>
          <div><dt>Seats filled</dt><dd><%= section.enrolledCount %> / <%= section.capacity %></dd></div>
        </dl>
        <% if (open && preview) { %>
          <button type="button" class="button primary" data-preview-action data-message="This preview shows the registration step. Sample records stay the same.">
            <%= full ? 'Preview waitlist' : 'Preview enrollment' %>
          </button>
        <% } else if (open && !user) { %>
          <a class="button primary" href="/auth/login?course=<%= course._id %>"><%= full ? 'Sign in to join waitlist' : 'Sign in to enroll' %></a>
        <% } else if (open && role === 'student') { %>
          <% if (registration?.status === 'completed') { %>
            <a class="text-link" href="/student/transcript">View your completed course ↗</a>
          <% } else if (registration) { %>
            <a class="text-link" href="/student/enrollments">View your registration ↗</a>
          <% } else { %>
            <form method="post" action="/student/enrollments/<%= section._id %>/register" data-submit>
              <button type="submit" class="button primary"><%= full ? 'Join waitlist' : 'Enroll' %></button>
            </form>
          <% } %>
        <% } %>
      </article>
    <% }) %>
  </section>
  <aside class="panel">
    <h2>Prerequisites</h2>
    <% if (course.prerequisites.length) { %>
      <ul class="plain-list">
        <% course.prerequisites.forEach(prerequisite => { %>
          <li><strong><%= prerequisite.code %></strong><span><%= prerequisite.title %></span></li>
        <% }) %>
      </ul>
      <p class="muted">You need a passing grade in each prerequisite before registering.</p>
    <% } else { %>
      <p class="notice">This course has no prerequisites.</p>
    <% } %>
  </aside>
</div>
<%- include('../partials/footer') %>
