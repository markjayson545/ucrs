<%- include('partials/head') %>
<div class="landing">
<nav class="landing-nav" aria-label="Main navigation"><a class="brand" href="/"><span class="brand-mark"><%- include('partials/icon', { name: 'book' }) %></span><span>UCRS<span class="brand-sub">CAMPUS CONNECTED</span></span></a><div><a href="/catalog/courses">Explore courses</a><a class="button primary" href="/auth/login">Sign in ↗</a></div></nav>
<main id="main"><section class="landing-hero"><div><p class="eyebrow">LESS ADMIN. MORE POSSIBILITY.</p><h1>Your next chapter<br>starts <em>here.</em></h1><p>Find your courses. Shape your semester. Keep your academic journey in one thoughtfully connected place.</p><div class="hero-actions"><a class="button primary" href="/student">Explore the student portal <%- include('partials/icon', { name: 'arrow' }) %></a><a class="text-link" href="/catalog/courses">Browse the catalog</a></div><div class="landing-proof"><span class="status-dot"></span>A little more clarity for every semester.</div></div><div class="hero-art" aria-hidden="true"><div class="arch arch-one"></div><div class="arch arch-two"></div><div class="art-sun"></div><div class="hero-art-caption">ROOM TO<br>GROW.<span>YOUR CAMPUS. YOUR POSSIBILITIES.</span></div><div class="floating-card"><span class="mini-icon"><%- include('partials/icon', { name: 'check' }) %></span><div><strong>A semester that fits you.</strong><small>Plan with confidence.</small></div></div></div></section>
<section class="landing-portals" aria-labelledby="portal-heading"><div class="row-between"><h2 id="portal-heading">One campus. Your own workspace.</h2><span class="badge">Interactive UI previews</span></div><div class="three-grid"><% [['student','For students','Discover courses, plan your week, and track your progress.','book'],['faculty','For faculty','Keep your sections, students, and gradebook together.','users'],['admin','For administrators','Bring clarity to courses, sections, and campus operations.','grid']].forEach(([r,t,d,i]) => { %><a href="/<%= r %>" class="portal-card"><span class="mini-icon"><%- include('partials/icon', { name: i }) %></span><h3><%= t %></h3><p><%= d %></p><span class="text-link">Explore workspace ↗</span></a><% }) %></div></section></main>
<footer class="landing-footer"><strong>UCRS</strong><span>University Course Registration System · Sample data preview</span><a href="/auth/register">Join your campus ↗</a></footer></div>
</body></html>
