<%- include('partials/head') %>
<div class="landing">
  <header class="landing-nav site-width">
    <%- include('partials/brand') %>
    <nav class="landing-links" aria-label="Main navigation">
      <a href="/catalog/courses">Course catalog</a>
      <a href="#workspaces">Workspaces</a>
    </nav>
    <div class="landing-actions">
      <% if (!preview && user) { %>
        <%- include('partials/profile-menu') %>
      <% } else { %>
        <%- include('partials/appearance-trigger') %>
        <a class="button primary" href="/auth/login">Sign in<%- include('partials/icon', { name: 'arrow' }) %></a>
      <% } %>
    </div>
  </header>

  <main id="main">
    <section class="landing-hero site-width">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> University course registration</p>
        <h1>Make this semester <em>yours.</em></h1>
        <p class="hero-description">Find the right courses, build a schedule that fits, and keep your academic progress in sight.</p>
        <div class="hero-actions">
          <a class="button primary" href="/catalog/courses">Explore courses <%- include('partials/icon', { name: 'arrow' }) %></a>
          <a class="button secondary" href="#workspaces">See the workspaces</a>
        </div>
      </div>
      <figure class="hero-photo">
        <img src="/images/campus-courtyard.webp" width="1440" height="960" fetchpriority="high"
          alt="University students crossing a sunlit campus courtyard between brick buildings">
      </figure>
    </section>

    <section class="showcase" id="workspaces" aria-labelledby="showcase-title" data-showcase>
      <div class="site-width">
        <div class="showcase-heading">
          <h2 id="showcase-title">A workspace for every role.</h2>
          <p>See what students, faculty, and administrators can do in the portal.</p>
        </div>
        <% const workspaces = [
          { key: 'student', role: 'Student', icon: 'calendar', title: 'Plan your week', text: 'See confirmed classes, rooms, and waitlist places in one timetable.', image: 'student-schedule.webp', path: '/student/schedule' },
          { key: 'faculty', role: 'Faculty', icon: 'book', title: 'Manage your gradebook', text: 'Open a section roster and publish grades to student transcripts.', image: 'faculty-gradebook.webp', path: '/faculty/sections/section-1/grades' },
          { key: 'admin', role: 'Administrator', icon: 'chart', title: 'Track enrollment', text: 'Compare seat usage and monitor waitlists across the term.', image: 'admin-reports.webp', path: '/admin/reports' },
        ]; %>
        <div class="showcase-tabs" role="tablist" aria-label="Workspace screenshots" hidden>
          <% workspaces.forEach(workspace => { %>
            <button type="button" id="tab-<%= workspace.key %>" role="tab" aria-controls="showcase-<%= workspace.key %>">
              <%- include('partials/icon', { name: workspace.icon }) %><%= workspace.role %>
            </button>
          <% }) %>
        </div>
        <% workspaces.forEach(workspace => { %>
          <article class="showcase-panel" id="showcase-<%= workspace.key %>">
            <div class="showcase-caption">
              <div><h3><%= workspace.title %></h3><p><%= workspace.text %></p></div>
              <% if (preview || !user || user.role === workspace.key) { %>
              <a class="button secondary" href="<%= preview ? workspace.path : user?.role === workspace.key ? '/' + workspace.key : '/auth/login' %>">
                <%= preview ? 'Open preview' : user?.role === workspace.key ? 'Open workspace' : 'Sign in' %>
                <%- include('partials/icon', { name: 'arrow' }) %>
              </a>
              <% } %>
            </div>
            <a class="screenshot-link" href="/images/showcase/<%= workspace.image %>" aria-label="Open full-size <%= workspace.role.toLowerCase() %> workspace screenshot">
              <img src="/images/showcase/<%= workspace.image %>" width="1440" height="850" loading="lazy"
                alt="<%= workspace.role %> workspace screenshot with sample records">
            </a>
          </article>
        <% }) %>
      </div>
    </section>
  </main>

  <footer class="landing-footer site-width">
    <%- include('partials/brand') %>
    <span>University Course Registration System<%= preview ? ' · Sample data preview' : '' %></span>
    <% if (!user || preview) { %><a class="text-link" href="/auth/register">Create a student account</a><% } %>
  </footer>
</div>
<% if (!preview && user) { %><%- include('partials/portal-dialog') %><% } %>
<script src="/javascripts/showcase.js" defer></script>
</body>
</html>
